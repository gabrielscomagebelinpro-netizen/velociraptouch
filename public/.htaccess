# Envoie toutes les requêtes vers index.php (front controller Symfony) sur un hébergement Apache.
DirectoryIndex index.php

# Pas de liste des fichiers d'un dossier.
Options -Indexes

# Fichiers cachés (.user.ini, .htaccess…) jamais servis ; le dossier .well-known reste accessible (certificat HTTPS).
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# En-têtes de sécurité (protection des données des visiteurs).
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Manifeste de l'application (ajout à l'écran d'accueil) : certains hébergeurs ne connaissent pas ce type.
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force le HTTPS.
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Détermine le chemin de base pour que la réécriture marche aussi dans un sous-dossier.
    RewriteCond %{REQUEST_URI}::$0 ^(/.+)/(.*)::\2$
    RewriteRule .* - [E=BASE:%1]

    # Transmet l'en-tête Authorization à PHP.
    RewriteCond %{HTTP:Authorization} .+
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%0]

    # Redirige /index.php/... vers l'URL propre.
    RewriteCond %{ENV:REDIRECT_STATUS} =""
    RewriteRule ^index\.php(?:/(.*)|$) %{ENV:BASE}/$1 [R=301,L]

    # Les fichiers existants (CSS, JS, images) sont servis directement.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Tout le reste passe par Symfony.
    RewriteRule ^ %{ENV:BASE}/index.php [L]
</IfModule>

<IfModule !mod_rewrite.c>
    <IfModule mod_alias.c>
        RedirectMatch 307 ^/$ /index.php/
    </IfModule>
</IfModule>

# router.php ne sert qu'au serveur PHP intégré en local.
<Files "router.php">
    Require all denied
</Files>
