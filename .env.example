APP_ENV=dev
MAILER_DSN="smtp://velociraptouch@gmail.com:REMPLACEZ_PAR_LE_MOT_DE_PASSE_APPLICATION@smtp.gmail.com:587?encryption=tls&auth_mode=login"
CONTACT_RECIPIENT="velociraptouch@gmail.com"
APP_SECRET=change-me-in-production
MESSAGES_FILE=%kernel.project_dir%/var/data/messages.json
DATABASE_URL="mysql://velociraptouch:velociraptouch@127.0.0.1:3310/velociraptouch?serverVersion=8.0&charset=utf8mb4"

# Boutique masquée pour le moment : passer à 1 pour la réafficher (page /boutique et liens du menu).
SHOP_ENABLED=0

# Proxys de confiance : seulement l'adresse réelle du proxy de l'hébergeur (ou 127.0.0.1).
# Ne jamais mettre REMOTE_ADDR : n'importe qui pourrait alors falsifier son adresse IP et le nom du site.
TRUSTED_PROXIES=127.0.0.1
