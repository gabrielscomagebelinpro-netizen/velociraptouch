{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe{% endblock %}

{% block body %}
<main id="contenu" tabindex="-1" class="admin-page-main">
    <div class="page-topbar">
        <p class="eyebrow">Accès au compte</p>
        <a class="button button-outline page-back" href="{{ path('app_login') }}">← Connexion</a>
    </div>
    <h1>Nouveau <span>mot de passe.</span></h1>
    {% if invalid %}
        <p class="form-note form-note-error" role="alert">Ce lien est invalide ou a expiré. Fais une nouvelle demande.</p>
        <p class="field-help mt-4"><a href="{{ path('password_forgot') }}">Demander un nouveau lien</a></p>
    {% else %}
        {% for message in app.flashes('error') %}<p class="form-note form-note-error" role="alert">{{ message }}</p>{% endfor %}
        <form method="post" class="contact-form mt-5" style="max-width: 480px">
            <label for="password">Nouveau mot de passe</label>
            <input class="form-control" type="password" id="password" name="password" autocomplete="new-password" minlength="12" required>
            <label for="confirmation">Confirmer le mot de passe</label>
            <input class="form-control" type="password" id="confirmation" name="confirmation" autocomplete="new-password" minlength="12" required>
            <input type="hidden" name="_token" value="{{ csrf_token('password-reset') }}">
            <p class="privacy-notice mt-0">Au moins 12 caractères, dont une majuscule, une minuscule, un chiffre et un caractère spécial.</p>
            <button class="button button-primary btn mt-4" type="submit">Réinitialiser <span>↗</span></button>
        </form>
    {% endif %}
</main>
{% endblock %}
