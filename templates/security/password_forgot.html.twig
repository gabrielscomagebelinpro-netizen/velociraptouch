{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié{% endblock %}

{% block body %}
<main id="contenu" tabindex="-1" class="admin-page-main">
    <div class="page-topbar">
        <p class="eyebrow">Accès au compte</p>
        <a class="button button-outline page-back" href="{{ path('app_login') }}">← Connexion</a>
    </div>
    <h1>Mot de passe <span>oublié.</span></h1>
    {% for message in app.flashes('reset') %}<p class="form-note" role="status">{{ message }}</p>{% endfor %}
    {% for message in app.flashes('error') %}<p class="form-note form-note-error" role="alert">{{ message }}</p>{% endfor %}
    <p class="field-help mt-4" style="max-width: 480px">Indique l’adresse email de ton compte : on t’envoie un lien, valable une heure, pour choisir un nouveau mot de passe.</p>
    <form method="post" class="contact-form mt-4" style="max-width: 480px">
        <label for="email">Adresse email</label>
        <input class="form-control" type="email" id="email" name="email" autocomplete="email" required>
        {# Champ piège : invisible pour les humains, rempli automatiquement par les robots. #}
        <div class="hp-field" aria-hidden="true"><label for="website">Site web</label><input type="text" id="website" name="website" tabindex="-1" autocomplete="off"></div>
        <input type="hidden" name="_token" value="{{ csrf_token('password-reset-request') }}">
        <button class="button button-primary btn mt-4" type="submit">Envoyer le lien <span>↗</span></button>
    </form>
</main>
{% endblock %}
