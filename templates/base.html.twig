<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="{% block meta_description %}Les Vélociraptouch — association de rugby touch, de sport et de convivialité.{% endblock %}" />
    <title>{% block title %}Les Vélociraptouch{% endblock %}</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/app/favicon-32.png" />
    {# Ajout à l'écran d'accueil : nom et icône de l'application. #}
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/assets/images/app/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Vélociraptouch" />
    <meta name="application-name" content="Vélociraptouch" />
    <meta name="theme-color" content="#163545" />
    {# RGPD : polices hébergées localement, aucune ressource tierce chargée sans consentement. #}
    <link rel="stylesheet" href="{{ versioned_asset('/assets/css/fonts.css') }}" />
    <link rel="stylesheet" href="{{ versioned_asset('/assets/css/site.css') }}" />
    {% block stylesheets %}{% endblock %}
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <div class="noise"></div>
    <header class="site-header">
      <a class="brand" href="{{ path('site_home') }}#accueil" aria-label="Accueil Vélociraptouch">
        <span class="brand-logo"><img src="/assets/images/brand/logo-velo-svg.png" alt="" /></span>
        <span>VÉLOCIRAPTOUCH</span>
      </a>
      <button class="menu-toggle btn p-0" type="button" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="menu-principal">☰</button>
      <nav class="main-nav navbar-nav flex-row" id="menu-principal" aria-label="Menu principal">
        {% block navigation %}
          <a href="{{ path('site_home') }}#collectif">Le collectif</a>
          <a href="{{ path('site_home') }}#agenda">Agenda</a>
          {% if shop_enabled %}<a href="{{ path('site_shop') }}">Boutique <span>↗</span></a>{% endif %}
          <a href="{{ path('site_home') }}#sponsors">Sponsors</a>
          <a href="{{ path('site_home') }}#contact">Contact</a>
        {% endblock %}
        {% if is_granted('ROLE_ADMIN') %}
          <a href="{{ path('admin_dashboard') }}">Administration</a>
        {% endif %}
        {% if app.user %}
          <a href="{{ path('account') }}">Mon compte</a>
          {# Déconnexion par formulaire avec jeton : un simple lien piégé ne peut pas déconnecter un membre. #}
          <form class="nav-logout-form" method="post" action="{{ path('admin_logout') }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
            <button class="nav-logout" type="submit">Déconnexion</button>
          </form>
        {% else %}
          <a href="{{ path('app_login') }}">Connexion</a>
          <a href="{{ path('app_register') }}">Inscription</a>
        {% endif %}
      </nav>
    </header>

    {% for message in app.flashes('account') %}<p class="form-note site-flash">{{ message }}</p>{% endfor %}
    {% block body %}{% endblock %}

    <footer>
      <a class="brand" href="{{ path('site_home') }}#accueil">
        <span class="brand-logo"><img src="/assets/images/brand/logo-velo-svg.png" alt="" /></span>
        <span>VÉLOCIRAPTOUCH</span>
      </a>
      <p>Rugby touch, collectif & bonne humeur à Montpellier.</p>
      <div>
        <a href="{{ path('site_home') }}#sponsors">Partenaires</a>
        <a href="{{ path('site_home') }}#contact">Nous contacter</a>
      </div>
    </footer>
    <nav class="footer-legal" aria-label="Informations légales">
      <span>© {{ 'now'|date('Y') }} {{ legal.name }}</span>
      <a href="{{ path('legal_notice') }}">Mentions légales</a>
      <a href="{{ path('legal_privacy') }}">Confidentialité et cookies</a>
      <a href="{{ path('legal_accessibility') }}">Accessibilité</a>
      {% if app.user %}<a href="{{ path('account') }}">Mes données</a>{% endif %}
    </nav>

    <script src="{{ versioned_asset('/assets/js/site.js') }}"></script>
    {% block javascripts %}{% endblock %}
  </body>
</html>
