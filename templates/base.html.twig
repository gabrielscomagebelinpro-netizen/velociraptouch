<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="{% block meta_description %}Les Vélociraptouch — association de rugby touch, de sport et de convivialité.{% endblock %}" />
    <title>{% block title %}Les Vélociraptouch{% endblock %}</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/app/favicon-32.png" />
    {# Ajout à l'écran d'accueil : nom et icône de l'application. #}
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/assets/images/app/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Vélociraptouch" />
    <meta name="application-name" content="Vélociraptouch" />
    <meta name="theme-color" content="#163545" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=DM+Sans:wght@400;500;600;700&family=Pinyon+Script&family=Racing+Sans+One&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctpRjDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link rel="stylesheet" href="{{ versioned_asset('/assets/css/site.css') }}" />
    {% block stylesheets %}{% endblock %}
  </head>
  <body>
    <div class="noise"></div>
    <header class="site-header">
      <a class="brand" href="{{ path('site_home') }}#accueil" aria-label="Accueil Vélociraptouch">
        <span class="brand-logo"><img src="/assets/images/brand/logo-velo-svg.png" alt="" /></span>
        <span>VÉLOCIRAPTOUCH</span>
      </a>
      <button class="menu-toggle btn p-0" aria-label="Ouvrir le menu">☰</button>
      <nav class="main-nav navbar-nav flex-row">
        {% block navigation %}
          <a href="{{ path('site_home') }}#collectif">Le collectif</a>
          <a href="{{ path('site_home') }}#agenda">Agenda</a>
          {% if shop_enabled %}<a href="{{ path('site_shop') }}">Boutique <span>↗</span></a>{% endif %}
          <a href="{{ path('site_home') }}#sponsors">Sponsors</a>
          <a href="{{ path('site_home') }}#contact">Contact</a>
        {% endblock %}
        {% if is_granted('ROLE_ADMIN') %}
          <a href="{{ path('admin_dashboard') }}">Administration</a>
        {% endif %}
        {% if app.user %}
          <a href="{{ path('admin_logout') }}">Déconnexion</a>
        {% else %}
          <a href="{{ path('app_login') }}">Connexion</a>
          <a href="{{ path('app_register') }}">Inscription</a>
        {% endif %}
      </nav>
    </header>

    {% block body %}{% endblock %}

    <footer>
      <a class="brand" href="{{ path('site_home') }}#accueil">
        <span class="brand-logo"><img src="/assets/images/brand/logo-velo-svg.png" alt="" /></span>
        <span>VÉLOCIRAPTOUCH</span>
      </a>
      <p>Rugby touch, collectif & bonne humeur à Montpellier.</p>
      <div>
        <a href="{{ path('site_home') }}#sponsors">Partenaires</a>
        <a class="footer-social" href="https://www.instagram.com/velocirap.touch/" target="_blank" rel="noreferrer"><svg class="social-icon" aria-hidden="true" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1"></circle></svg> Instagram</a>
        <a class="footer-social" href="https://www.tiktok.com/@velocirap.touch?_r=1&_t=ZN-9AkDFSuwcw2" target="_blank" rel="noreferrer"><svg class="social-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M14 4v10.2a4.8 4.8 0 1 1-4-4.74"></path><path d="M14 4c.5 2.7 2.1 4.2 5 4.5"></path></svg> TikTok</a>
        <a href="{{ path('site_home') }}#contact">Nous contacter</a>
      </div>
    </footer>

    <script src="{{ versioned_asset('/assets/js/site.js') }}"></script>
    {% block javascripts %}{% endblock %}
  </body>
</html>
