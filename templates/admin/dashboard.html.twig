{% extends 'base.html.twig' %}

{% block title %}Administration — Agenda{% endblock %}

{% block body %}
<main class="admin-page-main">
    <div class="admin-page-header">
        <div>
            <p class="eyebrow">Espace administration</p>
            <h1>Gérer <span>le site.</span></h1>
            <p class="admin-page-intro">Gère ici le contenu du site, les événements{% if shop_enabled %} et bientôt les produits de la boutique{% endif %}.</p>
        </div>
        <div class="admin-header-actions">
            <a class="button button-outline" href="{{ path('site_home') }}">← Accueil</a>
            {% if shop_enabled %}<a class="button button-outline" href="{{ path('site_shop') }}">Boutique</a>{% endif %}
        </div>
    </div>
    {% include 'admin/_tabs.html.twig' with {active: 'admin_dashboard'} %}
    {% for message in app.flashes('success') %}<p class="form-note">{{ message }}</p>{% endfor %}
    <div class="admin-page-grid">
        <section class="admin-card admin-create-card">
            <h2>Ajouter un événement</h2>
            {{ form_start(form, {attr: {class: 'contact-form'}}) }}
            {{ form_row(form.date, {attr: {class: 'form-control'}}) }}
            {{ form_row(form.title, {attr: {class: 'form-control'}}) }}
            {{ form_row(form.description, {attr: {class: 'form-control'}}) }}
            <button class="button button-primary btn" type="submit">Ajouter à l’agenda <span>↗</span></button>
            {{ form_end(form) }}
        </section>
        <section class="admin-card admin-events-card">
            <h2>Événements à venir</h2>
            <div class="admin-content-list">
            {% for event in events %}
                <article class="admin-event-row">
                    <div><strong>{{ event.date|format_datetime(pattern='dd/MM/y', locale='fr') }} — {{ event.title }}</strong><span>{{ event.description }}</span></div>
                    <div class="admin-row-actions">
                        <a class="button button-primary btn" href="{{ path('admin_event_edit', {id: event.id}) }}#event-photos">Ajouter des photos <span>↗</span></a>
                        <a class="text-link" href="{{ path('admin_event_edit', {id: event.id}) }}">Modifier <span>→</span></a>
                        <a class="text-link" href="{{ path('admin_event_attendance_pdf', {id: event.id}) }}">PDF <span>↓</span></a>
                        <form method="post" action="{{ path('admin_event_delete', {id: event.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-event-' ~ event.id) }}">
                            <button class="text-button" type="submit">Supprimer</button>
                        </form>
                    </div>
                </article>
            {% else %}
                <p class="field-help">Aucun événement enregistré.</p>
            {% endfor %}
            </div>
        </section>
        <section class="admin-card admin-albums-card">
            <h2>Photos des événements</h2>
            <p class="field-help">Tous les événements qui ont des photos, y compris les événements passés.</p>
            <div class="admin-content-list">
            {% for album in photoAlbums %}
                <article class="admin-event-row">
                    <div><strong>{{ album.event.date ? album.event.date|format_datetime(pattern='dd/MM/y', locale='fr') ~ ' — ' }}{{ album.event.title }}</strong><span>{{ album.photoCount }} photo{{ album.photoCount > 1 ? 's' }}</span></div>
                    <div class="admin-row-actions">
                        <a class="button button-primary btn" href="{{ path('admin_event_photos_zip', {id: album.event.id}) }}">Tout télécharger <span>↓</span></a>
                        <a class="text-link" href="{{ path('admin_event_edit', {id: album.event.id}) }}#event-photos">Voir les photos <span>→</span></a>
                    </div>
                </article>
            {% else %}
                <p class="field-help">Aucune photo pour le moment.</p>
            {% endfor %}
            </div>
        </section>
    </div>
</main>
{% endblock %}
