{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as ui %}

{% block title %}Administration — Agenda{% endblock %}

{% block body %}
<main id="contenu" tabindex="-1" class="admin-page-main">
    <div class="page-topbar">
        <p class="eyebrow">Espace administration</p>
        <div class="page-topbar-actions">
            {% if shop_enabled %}<a class="button button-outline" href="{{ path('site_shop') }}">Boutique</a>{% endif %}
            <a class="button button-outline page-back" href="{{ path('site_home') }}">← Accueil</a>
        </div>
    </div>
    <div class="admin-page-header">
        <div>
            <h1>Gérer <span>le site.</span></h1>
            <p class="admin-page-intro">Gère ici le contenu du site, les événements{% if shop_enabled %} et bientôt les produits de la boutique{% endif %}.</p>
        </div>
    </div>
    {% include 'admin/_tabs.html.twig' with {active: 'admin_dashboard'} %}
    {% for message in app.flashes('success') %}<p class="form-note">{{ message }}</p>{% endfor %}
    <div class="admin-page-grid">
        <section class="admin-card admin-create-card">
            <h2>Ajouter un événement</h2>
            {{ form_start(form, {attr: {class: 'contact-form'}}) }}
            {{ form_row(form.date, {attr: {class: 'form-control'}}) }}
            {{ form_row(form.title, {attr: {class: 'form-control'}}) }}
            {{ form_row(form.description, {attr: {class: 'form-control'}}) }}
            <button class="button button-primary btn" type="submit">Ajouter à l’agenda {{ ui.icon('calendar_add') }}</button>
            {{ form_end(form) }}
        </section>
        <div class="admin-stack">
            <section class="admin-card admin-events-card">
                <h2>Événements à venir <span class="admin-count">({{ events|length }})</span></h2>
                <div class="admin-content-list">
                {% for event in events %}
                    <article class="admin-event-row">
                        <div class="admin-event-info">
                            <time class="admin-event-date" datetime="{{ event.date|date('Y-m-d') }}">{{ event.date|format_datetime(pattern='EEE dd/MM/y', locale='fr') }}</time>
                            <strong>{{ event.title }}</strong>
                            {% if event.description %}<span>{{ event.description }}</span>{% endif %}
                        </div>
                        <div class="admin-row-actions">
                            <a class="button button-primary" href="{{ path('admin_event_edit', {id: event.id}) }}#event-photos">Photos {{ ui.icon('photos') }}</a>
                            <a class="button button-outline" href="{{ path('admin_event_edit', {id: event.id}) }}">Modifier {{ ui.icon('edit') }}</a>
                            <a class="button button-outline" href="{{ path('admin_event_attendance_pdf', {id: event.id}) }}" title="Télécharger la feuille de présences (PDF)">Présences {{ ui.icon('attendance') }}</a>
                            <form method="post" action="{{ path('admin_event_delete', {id: event.id}) }}" data-confirm="Supprimer l’événement « {{ event.title }} » ?">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-event-' ~ event.id) }}">
                                <button class="button button-danger" type="submit">Supprimer {{ ui.icon('trash') }}</button>
                            </form>
                        </div>
                    </article>
                {% else %}
                    <p class="field-help">Aucun événement enregistré.</p>
                {% endfor %}
                </div>
                {# Archive repliée : les événements passés ne sont plus sur le site public mais restent accessibles pour leurs photos. #}
                {% if pastEvents is not empty %}
                    <details class="admin-past-events">
                        <summary>Événements passés ({{ pastEvents|length }})</summary>
                        <div class="admin-content-list">
                        {% for event in pastEvents %}
                            {% set photoCount = photoCounts[event.id] ?? 0 %}
                            <article class="admin-event-row is-past">
                                <div class="admin-event-info">
                                    <time class="admin-event-date" datetime="{{ event.date|date('Y-m-d') }}">{{ event.date|format_datetime(pattern='EEE dd/MM/y', locale='fr') }}</time>
                                    <strong>{{ event.title }}</strong>
                                    <span>{{ photoCount ? photoCount ~ ' photo' ~ (photoCount > 1 ? 's') : 'Aucune photo' }}</span>
                                </div>
                                <div class="admin-row-actions">
                                    <a class="button button-primary" href="{{ path('admin_event_edit', {id: event.id}) }}#event-photos">Photos {{ ui.icon('photos') }}</a>
                                    <a class="button button-outline" href="{{ path('admin_event_edit', {id: event.id}) }}">Modifier {{ ui.icon('edit') }}</a>
                                </div>
                            </article>
                        {% endfor %}
                        </div>
                    </details>
                {% endif %}
            </section>
            <section class="admin-card admin-albums-card">
                <h2>Photos des événements</h2>
                <p class="field-help">Tous les événements qui ont des photos, y compris les événements passés.</p>
                <div class="admin-content-list">
                {% for album in photoAlbums %}
                    <article class="admin-event-row">
                        <div class="admin-event-info">
                            {% if album.event.date %}<time class="admin-event-date" datetime="{{ album.event.date|date('Y-m-d') }}">{{ album.event.date|format_datetime(pattern='EEE dd/MM/y', locale='fr') }}</time>{% endif %}
                            <strong>{{ album.event.title }}</strong>
                            <span>{{ album.photoCount }} photo{{ album.photoCount > 1 ? 's' }}</span>
                        </div>
                        <div class="admin-row-actions">
                            <a class="button button-primary desktop-only" href="{{ path('admin_event_photos_zip', {id: album.event.id}) }}">Tout télécharger {{ ui.icon('archive') }}</a>
                            <a class="button button-primary mobile-only" href="{{ path('admin_event_edit', {id: album.event.id}) }}#event-photos">Enregistrer {{ ui.icon('phone') }}</a>
                            <a class="button button-outline" href="{{ path('admin_event_edit', {id: album.event.id}) }}#event-photos">Voir {{ ui.icon('view') }}</a>
                        </div>
                    </article>
                {% else %}
                    <p class="field-help">Aucune photo pour le moment.</p>
                {% endfor %}
                </div>
            </section>
        </div>
    </div>
</main>
{% endblock %}
