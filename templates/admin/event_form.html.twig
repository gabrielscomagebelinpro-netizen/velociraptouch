{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as ui %}

{% block title %}Modifier un événement{% endblock %}

{% block body %}
<main id="contenu" tabindex="-1" class="admin-page-main">
    <div class="page-topbar">
        <p class="eyebrow">Espace administration</p>
        <a class="button button-outline page-back" href="{{ path('admin_dashboard') }}">← Panel</a>
    </div>
    <h1>Modifier <span>l’événement.</span></h1>
    {% for message in app.flashes('success') %}<p class="form-note">{{ message }}</p>{% endfor %}
    {% for message in app.flashes('error') %}<p class="form-note form-note-error">{{ message }}</p>{% endfor %}
    <section class="admin-card admin-edit-card">
        {{ form_start(form, {attr: {class: 'contact-form'}}) }}
        {{ form_row(form.date, {attr: {class: 'form-control'}}) }}
        {{ form_row(form.title, {attr: {class: 'form-control'}}) }}
        {{ form_row(form.description, {attr: {class: 'form-control'}}) }}
        <div class="admin-form-actions">
            <button class="button button-primary btn" type="submit">Enregistrer {{ ui.icon('save') }}</button>
            <a class="button button-outline" href="{{ path('admin_dashboard') }}">Annuler</a>
        </div>
        {{ form_end(form) }}
    </section>
    <section class="admin-card admin-photos-card" id="event-photos">
        <h2>Photos de l’événement</h2>
        <p class="field-help">Les fichiers originaux sont conservés sans compression. JPEG, PNG, WebP, HEIC ou HEIF, 25 Mo maximum par photo.</p>
        <form class="event-photo-upload" method="post" action="{{ path('admin_event_photos_upload', {id: event.id}) }}" enctype="multipart/form-data">
            <input type="hidden" name="_token" value="{{ csrf_token('event-photos-' ~ event.id) }}">
            <label class="photo-dropzone" for="event-photos-input">
                <strong>Dépose tes photos ici</strong>
                <span>ou appuie pour les choisir depuis ton téléphone</span>
                <input id="event-photos-input" name="photos[]" type="file" accept="image/jpeg,image/png,image/webp,image/heic,image/heif" multiple>
            </label>
            <div class="photo-upload-status" aria-live="polite">Aucune photo sélectionnée</div>
            <div class="photo-upload-preview" aria-live="polite"></div>
            <button class="button button-primary btn" type="submit">Ajouter les photos {{ ui.icon('upload') }}</button>
        </form>
        {% if photos is not empty %}
            {# Sur téléphone, le bouton « Enregistrer dans mes photos » (partage natif) remplace le ZIP, difficile à ouvrir. #}
            <div class="admin-form-actions photo-download-actions">
                <button class="button button-primary btn photo-share-button" type="button" hidden
                        data-photos="{{ photos|map(p => {url: path('admin_event_photo_view', {id: event.id, filename: p.filename}), name: p.originalName, type: p.mimeType})|json_encode }}">
                    Enregistrer dans mes photos {{ ui.icon('phone') }}
                </button>
                <a class="button button-outline photo-zip-link" href="{{ path('admin_event_photos_zip', {id: event.id}) }}">Télécharger toutes les photos (.zip, {{ photos|length }}) {{ ui.icon('archive') }}</a>
            </div>
            <p class="field-help photo-share-status" aria-live="polite" hidden></p>
            <div class="event-photo-grid">
                {% for photo in photos %}
                    <figure>
                        <img src="{{ path('admin_event_photo_view', {id: event.id, filename: photo.filename}) }}" alt="{{ photo.originalName|e }}">
                        <figcaption>
                            <span title="{{ photo.originalName }}">{{ photo.originalName }}</span>
                            <div class="photo-actions">
                                <a class="button button-outline" href="{{ path('admin_event_photo_download', {id: event.id, photoId: photo.id}) }}" aria-label="Télécharger {{ photo.originalName }}" title="Télécharger">{{ ui.icon('download') }} <span class="photo-action-label">Télécharger</span></a>
                                <form method="post" action="{{ path('admin_event_photo_delete', {id: event.id, photoId: photo.id}) }}" data-confirm="Supprimer cette photo ?">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete-event-photo-' ~ photo.id) }}">
                                    <button class="button button-danger" type="submit" aria-label="Supprimer {{ photo.originalName }}" title="Supprimer">{{ ui.icon('trash') }} <span class="photo-action-label">Supprimer</span></button>
                                </form>
                            </div>
                        </figcaption>
                    </figure>
                {% endfor %}
            </div>
        {% else %}
            <p class="field-help">Aucune photo pour cet événement.</p>
        {% endif %}
    </section>
</main>
{% endblock %}
