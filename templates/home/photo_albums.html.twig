{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as ui %}

{% block title %}Photos{% endblock %}

{% block body %}
<main id="contenu" tabindex="-1" class="section photo-albums-page">
    <div class="container-fluid">
        <div class="section-heading heading-row">
            <div><p class="eyebrow">Nos souvenirs</p><h1>Photos<span>.</span></h1></div>
        </div>
        <div class="photo-albums-grid">
        {% for album in albums %}
            {% set count = photoCounts[album.id] ?? 0 %}
            {% set cover = album.photos|first %}
            <a class="photo-album-card" href="{{ path('photo_album_view', {id: album.id}) }}">
                {% if cover %}
                    <img src="{{ path('photo_album_photo_view', {id: album.id, filename: cover.filename}) }}" alt="{{ album.title|e }}" loading="eager" decoding="async">
                {% else %}
                    <div class="photo-album-placeholder">{{ ui.icon('photos') }}</div>
                {% endif %}
                <div class="photo-album-card-copy">
                    <h2>{{ album.title }}</h2>
                    <p>{{ album.description|length > 150 ? album.description|slice(0, 150) ~ '…' : album.description }}</p>
                    <span>{{ count }} photo{{ count > 1 ? 's' }}</span>
                </div>
            </a>
        {% else %}
            <p class="empty-state">Aucun album photo pour le moment.</p>
        {% endfor %}
        </div>
    </div>
</main>
{% endblock %}
